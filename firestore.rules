rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hogarExiste(hogarId) {
      return exists(/databases/$(database)/documents/hogares/$(hogarId));
    }

    function hogarData(hogarId) {
      return get(/databases/$(database)/documents/hogares/$(hogarId)).data;
    }

    function isHogarMember(hogarId) {
      return isSignedIn() &&
        hogarId != '' &&
        hogarExiste(hogarId) &&
        request.auth.uid in hogarData(hogarId).get('miembros', []);
    }

    function isHogarAdmin(hogarId) {
      return isHogarMember(hogarId) &&
        (request.auth.uid == hogarData(hogarId).get('creador_id', '') ||
         request.auth.uid in hogarData(hogarId).get('administradores', []));
    }

    function configContexto(docId) {
      return docId.split('_')[2];
    }

    function esConfigHogar(docId) {
      return isSignedIn() &&
        docId.matches('^hogar_config_[A-Za-z0-9]+$') &&
        isHogarMember(configContexto(docId));
    }

    function esConfigPersonal(docId) {
      return isSignedIn() &&
        docId.matches('^estado_deudas_[A-Za-z0-9]+$') &&
        configContexto(docId) == request.auth.uid;
    }

    function perfilPublicoValido(data) {
      return data.keys().hasOnly(['nombre', 'avatar_url', 'actualizado_en']) &&
        data.nombre is string &&
        data.nombre.size() > 0 &&
        data.nombre.size() <= 80 &&
        data.avatar_url is string &&
        data.avatar_url.size() <= 500 &&
        data.actualizado_en == request.time;
    }

    function gastoValido(data) {
      return data.get('monto', 0) is number &&
        data.get('monto', 0) > 0 &&
        data.get('fecha', '') is string &&
        data.get('fecha', '').size() >= 8 &&
        data.get('fecha', '').size() <= 30 &&
        (data.get('tipo', '') == 'pagoDeuda' ||
         (data.get('categoria', '') is string && data.get('categoria', '').size() > 0));
    }

    function hogarValido(data) {
      return data.get('nombre', '') is string &&
        data.get('nombre', '').size() > 0 &&
        data.get('nombre', '').size() <= 100 &&
        data.get('miembros', []) is list &&
        data.get('miembros', []).size() > 0;
    }

    function puedeSalirDeHogar() {
      return isSignedIn() &&
        request.auth.uid in resource.data.get('miembros', []) &&
        !(request.auth.uid in request.resource.data.get('miembros', [])) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros', 'administradores']) &&
        request.resource.data.get('miembros', []).size() == resource.data.get('miembros', []).size() - 1 &&
        resource.data.get('miembros', []).hasAll(request.resource.data.get('miembros', []));
    }

    function invitacionData(hogarId, codigo) {
      return get(/databases/$(database)/documents/hogares/$(hogarId)/invitaciones/$(codigo)).data;
    }

    function invitacionConsumiblePorMi(hogarId, codigo) {
      return isSignedIn() &&
        codigo is string &&
        codigo.matches('^[A-Z0-9]{8,64}$') &&
        exists(/databases/$(database)/documents/hogares/$(hogarId)/invitaciones/$(codigo)) &&
        invitacionData(hogarId, codigo).get('hogar_id', '') == hogarId &&
        (invitacionData(hogarId, codigo).get('estado', '') == 'pendiente' ||
         (invitacionData(hogarId, codigo).get('estado', '') == 'usada' &&
          invitacionData(hogarId, codigo).get('usada_por', '') == request.auth.uid)) &&
        invitacionData(hogarId, codigo).get('expira_en', request.time) > request.time &&
        (invitacionData(hogarId, codigo).get('invitado_uid', null) == null ||
         invitacionData(hogarId, codigo).get('invitado_uid', '') == request.auth.uid);
    }

    function puedeUnirseConInvitacion(hogarId) {
      return isSignedIn() &&
        !(request.auth.uid in resource.data.get('miembros', [])) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'miembros',
          'codigos_usados',
          'ultima_invitacion'
        ]) &&
        request.resource.data.get('ultima_invitacion', {}).keys().hasOnly(['codigo', 'uid']) &&
        request.resource.data.get('ultima_invitacion', {}).get('uid', '') == request.auth.uid &&
        request.resource.data.get('ultima_invitacion', {}).get('codigo', '') is string &&
        request.resource.data.get('ultima_invitacion', {}).get('codigo', '').matches('^[A-Z0-9]{8,64}$') &&
        request.resource.data.get('miembros', []).hasAll(resource.data.get('miembros', [])) &&
        request.resource.data.get('miembros', []).size() == resource.data.get('miembros', []).size() + 1 &&
        request.auth.uid in request.resource.data.get('miembros', []) &&
        request.resource.data.get('codigos_usados', []).hasAll(resource.data.get('codigos_usados', [])) &&
        request.resource.data.get('codigos_usados', []).size() == resource.data.get('codigos_usados', []).size() + 1 &&
        request.resource.data.get('codigos_usados', []).hasAll([
          request.resource.data.get('ultima_invitacion', {}).get('codigo', '')
        ]) &&
        !resource.data.get('codigos_usados', []).hasAny([
          request.resource.data.get('ultima_invitacion', {}).get('codigo', '')
        ]) &&
        invitacionConsumiblePorMi(
          hogarId,
          request.resource.data.get('ultima_invitacion', {}).get('codigo', '')
        );
    }

    match /perfiles_publicos/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSelf(userId) &&
        perfilPublicoValido(request.resource.data);
      allow delete: if isSelf(userId);
    }

    match /usuarios/{userId} {
      allow get: if isSelf(userId);
      allow list: if false;
      allow create: if isSelf(userId);
      allow update: if isSelf(userId);
      allow delete: if false;

      match /gastos/{gastoId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId) &&
          gastoValido(request.resource.data) &&
          request.resource.data.get('usuario_id', '') == request.auth.uid &&
          request.resource.data.get('responsable', '') == request.auth.uid;
        allow update: if isSelf(userId) &&
          gastoValido(request.resource.data) &&
          resource.data.get('usuario_id', '') == request.auth.uid &&
          request.resource.data.get('usuario_id', '') == request.auth.uid &&
          request.resource.data.get('responsable', '') == request.auth.uid;
        allow delete: if isSelf(userId) &&
          resource.data.get('usuario_id', '') == request.auth.uid;
      }
    }

    match /hogares/{hogarId} {
      allow get: if isHogarMember(hogarId);
      allow list: if isSignedIn() &&
        request.auth.uid in resource.data.get('miembros', []);
      allow create: if isSignedIn() &&
        hogarValido(request.resource.data) &&
        request.resource.data.get('creador_id', '') == request.auth.uid &&
        request.auth.uid in request.resource.data.get('miembros', []);
      allow update: if puedeUnirseConInvitacion(hogarId) ||
        puedeSalirDeHogar() ||
        (isHogarAdmin(hogarId) && hogarValido(request.resource.data)) ||
        (isHogarMember(hogarId) &&
         hogarValido(request.resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'nombre',
           'categorias_compartidas',
           'presupuestos_compartidos',
           'metodos_pago'
         ]));
      allow delete: if isHogarAdmin(hogarId);

      match /gastos/{gastoId} {
        allow read: if isHogarMember(hogarId);
        allow create: if isHogarMember(hogarId) &&
          gastoValido(request.resource.data) &&
          request.resource.data.get('usuario_id', '') == request.auth.uid;
        allow update: if isHogarMember(hogarId) &&
          gastoValido(request.resource.data) &&
          resource.data.get('usuario_id', '') == request.auth.uid &&
          request.resource.data.get('usuario_id', '') == request.auth.uid;
        allow delete: if isHogarMember(hogarId);
      }

      match /invitaciones/{codigo} {
        allow get: if isSignedIn();
        allow list: if isHogarAdmin(hogarId);
        allow create: if isHogarAdmin(hogarId) &&
          codigo is string &&
          codigo.matches('^[A-Z0-9]{8,64}$') &&
          request.resource.data.keys().hasOnly([
            'codigo',
            'hogar_id',
            'creada_por',
            'creada_en',
            'expira_en',
            'invitado_uid',
            'estado'
          ]) &&
          request.resource.data.codigo == codigo &&
          request.resource.data.hogar_id == hogarId &&
          request.resource.data.creada_por == request.auth.uid &&
          request.resource.data.estado == 'pendiente' &&
          request.resource.data.creada_en == request.time &&
          request.resource.data.expira_en > request.time &&
          request.resource.data.expira_en <= request.time + duration.value(7, 'd') &&
          (request.resource.data.get('invitado_uid', null) == null ||
           request.resource.data.get('invitado_uid', '') is string);
        allow update: if (
          isSignedIn() &&
          resource.data.hogar_id == hogarId &&
          resource.data.estado == 'pendiente' &&
          resource.data.expira_en > request.time &&
          (resource.data.get('invitado_uid', null) == null ||
           resource.data.get('invitado_uid', '') == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado',
            'usada_por',
            'usada_en'
          ]) &&
          request.resource.data.estado == 'usada' &&
          request.resource.data.usada_por == request.auth.uid &&
          request.resource.data.usada_en == request.time
        ) || (
          isHogarAdmin(hogarId) &&
          resource.data.estado == 'pendiente' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado',
            'revocada_por',
            'revocada_en'
          ]) &&
          request.resource.data.estado == 'revocada' &&
          request.resource.data.revocada_por == request.auth.uid &&
          request.resource.data.revocada_en == request.time
        );
        allow delete: if isHogarAdmin(hogarId);
      }
    }

    match /config/{docId} {
      allow get: if esConfigHogar(docId) || esConfigPersonal(docId);
      allow list: if esConfigHogar(docId) || esConfigPersonal(docId);
      allow create: if esConfigHogar(docId) || esConfigPersonal(docId);
      allow update: if esConfigHogar(docId) || esConfigPersonal(docId);
      allow delete: if false;
    }
  }
}